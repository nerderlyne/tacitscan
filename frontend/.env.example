# Same Postgres the indexer writes to. A pooled connection string still
# works fine on Render's long-lived Node service; a direct connection is
# also OK since we hold a single pool per instance.
DATABASE_URL=postgres://user:pass@host:5432/tacitscan?sslmode=require

# Public name shown in the UI. "tacitscan", "TacitScan (signet)", etc.
PUBLIC_SITE_NAME=tacitscan
PUBLIC_NETWORK=mainnet
